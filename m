d349d922ba44e4348a17a78ea51b7135965b1/drivers/ntb>/hw<https://github.com/to=
rvalds/linux/tree/6f0d349d922ba44e4348a17a78ea51b7135965b1/drivers/ntb/hw>/=
intel<https://github.com/torvalds/linux/tree/6f0d349d922ba44e4348a17a78ea51=
b7135965b1/drivers/ntb/hw/intel>/ntb_hw_gen1.h:  #define XEON_WCCNTRL_OFFSE=
